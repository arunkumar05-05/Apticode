datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sqlite-client"
}

model User {
  id                     String                  @id @default(uuid())
  email                  String                  @unique
  passwordHash           String?
  firebaseUid            String?                 @unique
  authProvider           String?
  fullName               String?
  role                   String                  @default("STUDENT")
  level                  Int                     @default(1)
  xp                     Int                     @default(0)
  isEmailVerified        Boolean                 @default(false)
  isOnboarded            Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  profile                Profile?
  refreshTokens          RefreshToken[]
  bookmarks              UserBookmark[]
  topicProgress          UserTopicProgress[]
  codingAttempts         CodingSubmission[]
  speechSessions         CommunicationSession[]
  mockInterviews         MockInterview[]
  aptitudeAttempts       UserAttempt[]
  resumes                Resume[]
  xpLogs                 XpLog[]
  notifications          Notification[]
  leaderboard            Leaderboard?
  sessions               Session[]
  auditLogs              AuthAuditLog[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationToken EmailVerificationToken?
}

model Profile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName                String?
  email                   String?
  phone                   String?
  college                 String?
  branch                  String?
  graduationYear          Int?
  registerNumber          String?
  skills                  String?
  bio                     String?
  github                  String?
  linkedin                String?
  portfolio               String?
  profilePhoto            String?
  resume                  String?
  placementReadinessIndex Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String? // NULL = pre-session legacy token; present → session-scoped
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
}

model Session {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo    String? // parsed client device hint
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime       @default(now())
  lastActivity  DateTime       @default(now())
  expiresAt     DateTime
  revoked       Boolean        @default(false)
  refreshTokens RefreshToken[]
  auditLogs     AuthAuditLog[]

  @@index([userId, revoked, expiresAt])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

model AuthAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  event     String // REGISTER, LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, REFRESH,
  // PASSWORD_RESET_REQUEST, PASSWORD_CHANGE, EMAIL_VERIFIED,
  // SESSION_REVOKED, TOKEN_REUSE_DETECTED, LOCKOUT
  ipAddress String?
  userAgent String?
  success   Boolean
  detail    String? // free-form, NEVER contains passwords/tokens/jwts
  createdAt DateTime @default(now())

  @@index([userId, event, success, createdAt])
  @@index([ipAddress, event, createdAt])
  @@index([event, success, createdAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, used])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique // one active verification token per user
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, used])
  @@index([expiresAt])
}

model XpLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Leaderboard {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp   Int      @default(0)
  rank      Int?
  updatedAt DateTime @updatedAt

  @@index([totalXp])
}

model AptitudeTopic {
  id           String              @id @default(uuid())
  name         String              @unique
  description  String?
  category     String
  createdAt    DateTime            @default(now())
  videos       AptitudeVideo[]
  notes        AptitudeNotes?
  questions    AptitudeQuestion[]
  userProgress UserTopicProgress[]
}

model AptitudeVideo {
  id             String        @id @default(uuid())
  topicId        String
  topic          AptitudeTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title          String
  url            String
  duration       Int
  youtubeVideoId String
  createdAt      DateTime      @default(now())
}

model AptitudeNotes {
  id        String        @id @default(uuid())
  topicId   String        @unique
  topic     AptitudeTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AptitudeQuestion {
  id            String         @id @default(uuid())
  topicId       String
  topic         AptitudeTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // 'A', 'B', 'C', 'D'
  explanation   String?
  difficulty    String         @default("MEDIUM")
  createdAt     DateTime       @default(now())
  bookmarks     UserBookmark[]

  @@index([topicId, difficulty])
  @@index([createdAt])
}

model UserBookmark {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   AptitudeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([userId, questionId])
}

model UserTopicProgress {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId         String
  topic           AptitudeTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  videosCompleted Boolean       @default(false)
  notesCompleted  Boolean       @default(false)
  quizScore       Decimal?
  completedAt     DateTime?

  @@unique([userId, topicId])
}

model CodingProblem {
  id            String             @id @default(uuid())
  title         String             @unique
  description   String
  timeLimitMs   Int                @default(2000)
  memoryLimitKb Int                @default(262144)
  difficulty    String             @default("MEDIUM")
  editorial     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  testcases     CodingTestcase[]
  attempts      CodingSubmission[]
}

model CodingTestcase {
  id             String        @id @default(uuid())
  problemId      String
  problem        CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  inputData      String
  expectedOutput String
  isHidden       Boolean       @default(true)
  createdAt      DateTime      @default(now())
}

model CodingSubmission {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code        String
  language    String        @default("python")
  status      String        @default("PENDING")
  executionMs Int?
  memoryKb    Int?
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([problemId, status])
}

model CommunicationSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionType  String
  transcript   String
  wpm          Int
  grammarScore Int
  fluencyScore Int
  confidence   Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionType])
}

model MockInterview {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewType  String
  overallScore   Int
  technicalScore Int
  softSkillScore Int
  feedbackReport String?
  createdAt      DateTime           @default(now())
  messages       InterviewMessage[]

  @@index([userId, createdAt])
  @@index([interviewType])
}

model InterviewMessage {
  id          String        @id @default(uuid())
  interviewId String
  interview   MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sender      String // 'INTERVIEWER' | 'USER'
  messageText String
  createdAt   DateTime      @default(now())

  @@index([interviewId, createdAt])
}

model UserAttempt {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId            String
  score              Int
  accuracy           Decimal
  timeTaken          Int // in seconds
  incorrectQuestions String // JSON string of array
  topicPerformance   String // JSON string
  completedAt        DateTime @default(now())

  @@index([userId, completedAt])
  @@index([topicId, completedAt])
}

model Resume {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionName String
  contentJson String // JSON string
  atsScore    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([atsScore])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

// ---------------------------------------------------------------- *
// Phase 4 — AI observability (additive; no API contract changes)
// ---------------------------------------------------------------- *

model AiMetrics {
  id               String   @id @default(uuid())
  requestId        String?
  userId           String?
  feature          String
  provider         String
  model            String
  startTime        DateTime
  endTime          DateTime
  durationMs       Int
  outcome          String   @default("SUCCESS") // SUCCESS | TIMEOUT | QUOTA_EXHAUSTED | RATE_LIMITED | SERVER_ERROR | AUTH_FAILURE | INVALID_REQUEST | CIRCUIT_OPEN | PARSE_ERROR
  errorCategory    String?
  retryCount       Int      @default(0)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCostUSD Float?
  createdAt        DateTime @default(now())

  @@index([feature, createdAt])
  @@index([provider, createdAt])
  @@index([outcome, createdAt])
  @@index([userId, createdAt])
}

model AiProviderHealth {
  id                  String    @id @default(uuid())
  provider            String    @unique
  healthy             Boolean
  circuitState        String    @default("CLOSED") // CLOSED | OPEN | HALF_OPEN
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  consecutiveFailures Int       @default(0)
  avgLatencyMs        Int?
  errorRate           Float?
  quotaExhausted      Boolean   @default(false)
  rateLimited         Boolean   @default(false)
  updatedAt           DateTime  @updatedAt

  @@index([provider])
}
