# Example environment for AptiCode server — Phase 5 (async code execution).
# Copy to .env and fill in. Never commit real secrets.
# Superset of the root .env.example; Phase 5 variables are documented below.

# --- Runtime ---
NODE_ENV=development            # development | staging | production
PORT=5001
HOST=127.0.0.1                  # use 0.0.0.0 in containers

# --- Database: PostgreSQL in prod, SQLite in dev (auto fallback) ---
DATABASE_URL=postgresql://USER:PASS@HOST:5432/apticode
# When DATABASE_URL is empty/unreachable in dev, SQLite (prisma/dev.db) is used.

# --- Redis for BullMQ (Phase 5). REQUIRED for async mode. ---
# Local dev:  docker compose up -d redis  →  REDIS_URL=redis://127.0.0.1:6379
# Upstash:    REDIS_URL=rediss://:TOKEN@REGION.central.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS=false                 # true for Upstash rediss:// URLs (or set true unconditionally)
BULLMQ_PREFIX=bull              # queue key prefix (separate from REDIS_TTL_SECONDS cache)
REDIS_TTL_SECONDS=300

# --- Judge0 remote code execution (Phase 5) ---
# Leave JUDGE0_API_URL empty to disable remote execution — submissions then
# fail fast with SYSTEM_ERROR (or run fully async once a runner is configured).
# Local runner:  docker compose --profile judge0 up -d
JUDGE0_API_URL=http://127.0.0.1:2358
JUDGE0_API_TOKEN=               # or legacy alias JUDGE0_AUTH_TOKEN
JUDGE0_AUTH_TYPE=header         # header | bearer | none
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_API_VERSION=ce           # ce | extra | self (selects static language-id bucket)
JUDGE0_FETCH_LANGUAGES=false    # true: refresh ids from GET /languages (TTL-cached)
JUDGE0_LANGUAGES_CACHE_TTL_MS=3600000
JUDGE0_WAIT_TIMEOUT_MS=30000    # wait=true round-trip timeout
JUDGE0_POLL_MODE=false          # true: POST for tokens then GET until terminal
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_POLL_MAX_ATTEMPTS=60
JUDGE0_CONCURRENCY=3            # jobs per worker process
JUDGE0_MAX_TESTCASES_PER_JOB=32
JUDGE0_MAX_CPU_SECONDS=15
JUDGE0_MAX_MEMORY_KB=512000
# JUDGE0_PROVIDER_OVERRIDE=      # test seam: force a registered mock provider name

# --- Queue pipeline (Phase 5) ---
QUEUE_SUBMISSION_ATTEMPTS=3
QUEUE_SUBMISSION_BACKOFF_MS=2000
QUEUE_RESULT_ATTEMPTS=5
QUEUE_JOB_MAX_DURATION_MS=300000
CODE_MAX_BYTES=65536

# --- Worker heartbeats (Phase 5) ---
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_MS=30000

# --- Gamification ---
CODE_XP_REWARD_SUBMISSION=250   # XP granted once per ACCEPTED submission

# --- Auth ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING            # min 32 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- AI provider (OpenAI-compatible; vsllm by default) ---
AI_API_KEY=
AI_API_URL=https://vsllm.com/v1
AI_MODEL=glm-4.7-flash-free
AI_TIMEOUT_MS=120000
GEMINI_API_KEY=

# --- Email (Nodemailer + SMTP). Dev uses console transport by default. ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM=no-reply@apticode.com
EMAIL_DEV_TRANSPORT=true

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Security / tuning ---
TRUST_PROXY=false
BODY_LIMIT=1mb
CORS_ORIGINS=http://localhost:5173,https://apticode.vercel.app

# --- Test gates (jest; off by default) ---
# RUN_REDIS_TESTS=true          # enables coding.redis.integration.test.ts (needs local Redis)
# RUN_LIVE_JUDGE0_TESTS=true    # enables coding.live.judge0.test.ts (needs a live Judge0 runner)
