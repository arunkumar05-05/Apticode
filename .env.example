# Example environment for AptiCode server.
# Copy to .env and fill in. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development            # development | staging | production
PORT=5001
HOST=127.0.0.1                  # use 0.0.0.0 in containers

# --- Database: PostgreSQL in prod, SQLite in dev (auto fallback) ---
DATABASE_URL=postgresql://USER:PASS@HOST:5432/apticode
# When DATABASE_URL is empty/unreachable in dev, SQLite (prisma/dev.db) is used.

# --- Redis cache (Upstash in prod / local redis for dev) ---
REDIS_URL=rediss://:TOKEN@REGION.central.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://REGION.upstash.io
UPSTASH_REDIS_TOKEN=
REDIS_TTL_SECONDS=300

# --- Auth ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING            # min 32 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- AI provider (OpenAI-compatible; vsllm by default) ---
AI_API_KEY=
AI_API_URL=https://vsllm.com/v1
AI_MODEL=glm-4.7-flash-free
AI_TIMEOUT_MS=120000
GEMINI_API_KEY=                 # optional fallback when set to a real key

# --- Email (Nodemailer + SMTP). Dev uses console transport by default. ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM=no-reply@apticode.com
EMAIL_DEV_TRANSPORT=true         # when true, mails log to console in dev

# --- Cloudinary (profiles, resumes, future uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- Security / tuning ---
TRUST_PROXY=false                # true behind Render/Railway reverse proxy
BODY_LIMIT=1mb
CORS_ORIGINS=http://localhost:5173,https://apticode.vercel.app
ALLOW_ALL_APTCODE=false        # only set true for wide-open dev ingress
